# Sao chép thành .env (đã nằm trong .gitignore). KHÔNG commit giá trị thật.

# --- LLM ---
PR_TRIAGE_LLM_BASE_URL=http://localhost:11434/v1
PR_TRIAGE_LLM_API_KEY=
PR_TRIAGE_LLM_MODEL=
# Chỉ đặt 1 khi mã được gửi đi là mã nguồn mở hoặc Z đã đồng ý bằng văn bản.
PR_TRIAGE_LLM_ALLOW_EXTERNAL=0

# --- GitHub App (xem docs/github-app.md) ---
GITHUB_APP_ID=
# Một trong hai: nội dung PEM (xuống dòng viết là \n) hoặc đường dẫn tệp.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
# Muối bí danh hóa người thao tác. Giữ bí mật, không đổi sau khi đã thu dữ liệu.
PR_TRIAGE_ALIAS_SALT=
# Token cho /stats và /metrics. Để trống thì hai endpoint này bị ẩn.
PR_TRIAGE_ADMIN_TOKEN=
# Chỉ xử lý các repo này (khớp mẫu, cách nhau bằng dấu phẩy). Để trống là mọi repo đã cài App.
PR_TRIAGE_ALLOWED_REPOS=
# Mỗi repo chỉ một đường kích hoạt (ADR 0018). Ví dụ: jenkins:acme/legacy-*,github-app:acme/web-*
# Bắt buộc đặt khi GitHub App và Jenkins cùng chạy trên một tổ chức. Để trống: mọi đường đều được.
PR_TRIAGE_ROUTES=

# Máy chủ git tự lưu trữ (ADR 0021). Đặt `..._URL` để bật; token là mã truy cập của một tài khoản bot
# có quyền đọc mã và comment trên PR. Repo của máy chủ này được ghi là `loại:đường/dẫn`, ví dụ
# PR_TRIAGE_ALLOWED_REPOS=gitlab:nhom/*,gitea:org/repo,bitbucket:KHOA/repo
# PR_TRIAGE_GITLAB_URL=https://gitlab.noi-bo.example
# PR_TRIAGE_GITLAB_TOKEN=
# PR_TRIAGE_GITLAB_WEBHOOK_SECRET=
# PR_TRIAGE_GITLAB_BOT_LOGIN=
# PR_TRIAGE_GITEA_URL=
# PR_TRIAGE_GITEA_TOKEN=
# PR_TRIAGE_GITEA_WEBHOOK_SECRET=
# PR_TRIAGE_GITEA_BOT_LOGIN=
# PR_TRIAGE_BITBUCKET_URL=
# PR_TRIAGE_BITBUCKET_TOKEN=
# PR_TRIAGE_BITBUCKET_WEBHOOK_SECRET=
# PR_TRIAGE_BITBUCKET_BOT_LOGIN=
