# Sao chép thành .env (đã nằm trong .gitignore). KHÔNG commit giá trị thật.

# --- LLM ---
PR_TRIAGE_LLM_BASE_URL=http://localhost:11434/v1
PR_TRIAGE_LLM_API_KEY=
PR_TRIAGE_LLM_MODEL=
# Chỉ đặt 1 khi mã được gửi đi là mã nguồn mở hoặc Z đã đồng ý bằng văn bản.
PR_TRIAGE_LLM_ALLOW_EXTERNAL=0

# --- GitHub App (xem docs/github-app.md) ---
GITHUB_APP_ID=
# Một trong hai: nội dung PEM (xuống dòng viết là \n) hoặc đường dẫn tệp.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
# Muối bí danh hóa người thao tác. Giữ bí mật, không đổi sau khi đã thu dữ liệu.
PR_TRIAGE_ALIAS_SALT=
# Token cho /stats và /metrics. Để trống thì hai endpoint này bị ẩn.
PR_TRIAGE_ADMIN_TOKEN=
# Chỉ xử lý các repo này (khớp mẫu, cách nhau bằng dấu phẩy). Để trống là mọi repo đã cài App.
PR_TRIAGE_ALLOWED_REPOS=
