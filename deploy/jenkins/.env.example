# Sao chép thành deploy/jenkins/.env (đã nằm trong .gitignore). KHÔNG commit giá trị thật.

# Mật khẩu đăng nhập Jenkins, tài khoản "admin".
JENKINS_ADMIN_PASSWORD=

# Danh sách repo bot được phép quét, cách nhau bằng dấu phẩy: owner/repo1,owner/repo2
# Webhook chấp nhận mẫu (owner/*), job hỏi định kỳ chỉ dùng tên đầy đủ. Để trống thì bot không quét repo nào.
PR_TRIAGE_ALLOWED_REPOS=
# Token GitHub phải đọc và comment được trên MỌI repo ở trên.
# Fine-grained token: Contents đọc, Pull requests đọc và ghi, Metadata đọc.
GITHUB_TOKEN=

# Token bí mật trong URL webhook: <jenkins>/generic-webhook-trigger/invoke?token=...
# Tạo bằng: openssl rand -hex 16
PR_TRIAGE_WEBHOOK_TOKEN=
# 1: bật job pr-triage-poll hỏi GitHub mỗi 2 phút (chạy cục bộ, webhook không tới được).
# 0: tắt, khi đã có webhook.
PR_TRIAGE_POLL=1

# --- LLM, API kiểu OpenAI ---
# Ollama chạy trên máy Windows: http://host.docker.internal:11434/v1 và đặt ALLOW_EXTERNAL=1
# (host.docker.internal không nằm trong danh sách localhost của bot).
PR_TRIAGE_LLM_BASE_URL=
PR_TRIAGE_LLM_MODEL=
PR_TRIAGE_LLM_API_KEY=
# Chỉ đặt 1 khi mã được gửi đi là mã của bạn, mã nguồn mở, hoặc công ty đã đồng ý bằng văn bản.
PR_TRIAGE_LLM_ALLOW_EXTERNAL=0

# --- Hành vi bot ---
# shadow: chạy và lưu số liệu, không đăng gì. comment: đăng comment lên PR.
PR_TRIAGE_MODE=shadow
# Cách được hiển thị trên PR: A, B hoặc C. Cả B và C luôn được chạy và lưu.
PR_TRIAGE_DISPLAY=C
